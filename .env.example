# ── Database ─────────────────────────────────────────────────────────────
DB_USER=vergabe
DB_PASSWORD=your-secure-password
DB_NAME=vergabe

# ── Application ───────────────────────────────────────────────────────────
# Required in production — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-min-32-chars
ADMIN_PASSWORD=your-admin-password

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://vergabe.cycl.group

# ── AI Summaries (optional) ───────────────────────────────────────────────
# Provider: anthropic | openai | ollama
SUMMARY_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Email Notifications (optional) ────────────────────────────────────────
# Leave SMTP_HOST empty to disable email sending
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=vergabe@localhost

# ── TLS (Let's Encrypt via Caddy) ─────────────────────────────────────────
ACME_EMAIL=admin@example.com
