{
    email {$ACME_EMAIL:admin@vergabe.io}
}

http://vergabe.cycl.group, :80 {
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy backend:8000 {
            header_up X-Forwarded-For {remote_host}
        }
    }

    handle /auth/* {
        reverse_proxy backend:8000 {
            header_up X-Forwarded-For {remote_host}
        }
    }

    handle /docs* {
        reverse_proxy backend:8000
    }

    handle /openapi.json {
        reverse_proxy backend:8000
    }

    handle /health {
        reverse_proxy backend:8000
    }

    reverse_proxy frontend:4173

    encode gzip
    log { output stdout }
}
